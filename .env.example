# Environment variables for AI File Search
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_file_search
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
SEARCH_TOP_K_DEFAULT=5
SEARCH_TOP_K_MAX=50
WATCH_DEBOUNCE_MS=1000
FILE_STABILITY_MS=1500
MAX_FILE_SIZE_MB=100
INDEX_WORKERS=1
LOG_LEVEL=INFO

# Konfigurasi Model AI Lokal (GGUF via llama-cpp)
# Opsi 1 (Default): Qwen 2.5 1.5B (~1.06 GB, Kualitas tertinggi)
# LLM_MODEL_NAME=qwen2.5-1.5b-instruct-q4_k_m.gguf
# LLM_REPO_ID=Qwen/Qwen2.5-1.5B-Instruct-GGUF

# Opsi 2 (Ultra-Cepat ~450 MB): Qwen 2.5 0.5B (Optimal untuk Hybrid RAG & CPU Ringan)
# LLM_MODEL_NAME=qwen2.5-0.5b-instruct-q4_k_m.gguf
# LLM_REPO_ID=Qwen/Qwen2.5-0.5B-Instruct-GGUF
