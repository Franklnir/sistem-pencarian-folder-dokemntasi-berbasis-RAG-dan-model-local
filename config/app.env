# ==============================================================================
# AI FILE SEARCH — Environment Configuration Specification v1.0
# ==============================================================================

# Server Network Binding (Section 21: default 127.0.0.1, not 0.0.0.0)
APP_HOST=127.0.0.1
APP_PORT=8000

# Database Connection (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_file_search

# Embedding Model Configuration (Section 14)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# Retrieval Parameters (Section 8 & 15)
SEARCH_TOP_K_DEFAULT=5
SEARCH_TOP_K_MAX=50

# Filesystem Ingestion & Stability (Section 10 & 11)
WATCH_DEBOUNCE_MS=1000
FILE_STABILITY_MS=1500
MAX_FILE_SIZE_MB=100
INDEX_WORKERS=1

# Observability (Section 26)
LOG_LEVEL=INFO
